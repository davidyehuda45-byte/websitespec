{
  "name": "blueprint-extractor",
  "description": "Ekstensi browser spesifikasi UI Markdown presisi untuk AI coding agents.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
